#!/usr/bin/env bash

# This installer requires bash, and it is normally PIPED to a shell
# (`curl … | bash`), which means the shebang above is never consulted — the
# shell that reads stdin is whatever the caller chose. The in-product updater
# picks `sh` whenever `bash --version` fails (installation/index.ts), so on a
# musl/Alpine host with no bash this file can be handed to dash.
#
# Under dash the very next line dies with `set: Illegal option -o pipefail`,
# and the rest of the script — [[ ]], arrays, ${var// /x}, `local` — is not
# parseable either. That produced a cryptic failure mid-run instead of a
# sentence anyone could act on.
#
# This guard is deliberately POSIX-only and deliberately FIRST: a shell reads
# and executes complete commands as it goes, so exiting here means the
# bash-only syntax further down is never parsed.
if [ -z "${BASH_VERSION:-}" ]; then
    echo "dragon: this installer requires bash, but is running under a different shell." >&2
    if command -v bash >/dev/null 2>&1; then
        echo "dragon: bash is installed - re-run the installer with it:" >&2
    else
        echo "dragon: install bash, then re-run the installer with it:" >&2
    fi
    echo "  curl -fsSL https://raw.githubusercontent.com/VELLORAAI/dragoncode-public-dist/main/install | bash" >&2
    exit 1
fi

set -euo pipefail
APP=dragon

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
DragonCode Installer

Usage: install.sh [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 1.0.180)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)
        --require-checksum  Refuse to install if the download cannot be checksum-verified

Examples:
    curl -fsSL https://raw.githubusercontent.com/VELLORAAI/dragoncode-public-dist/main/install | bash
    curl -fsSL https://raw.githubusercontent.com/VELLORAAI/dragoncode-public-dist/main/install | bash -s -- --version 1.0.0
    ./install --binary /path/to/dragon
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""
# Refuse to install when the archive cannot be checksum-verified, instead of
# warning and continuing.
require_checksum=false
# Set by check_version when $INSTALL_DIR already holds the requested version.
skip_download=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        --require-checksum)
            require_checksum=true
            shift
            ;;
        *)
            # Was a warning that shifted and carried on. In a script whose whole
            # job is version pinning, that turned a typo into a SILENT pin
            # failure: `--verison 1.5.61` warned twice and installed *latest*,
            # and the only evidence was two lines of scrollback. Refuse instead.
            echo -e "${RED}Error: unknown option '$1'${NC}" >&2
            echo "" >&2
            usage >&2
            exit 1
            ;;
    esac
done

INSTALL_DIR=$HOME/.dragoncode/bin
mkdir -p "$INSTALL_DIR"

# Installed executable name; Windows binaries are dragon.exe (set below once the
# OS is known). `dragon` on PATH resolves dragon.exe on Windows.
bin_name="dragon"

# If --binary is provided, skip all download/detection logic
if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
        exit 1
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    combo="$os-$arch"
    case "$combo" in
      linux-x64|linux-arm64|darwin-arm64|darwin-x64|windows-x64)
        ;;
      *)
        echo -e "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
        ;;
    esac

    archive_ext=".zip"
    if [ "$os" = "linux" ]; then
      archive_ext=".tar.gz"
    fi

    # Windows release binaries are dragon.exe (inside dragon-windows-x64.zip).
    if [ "$os" = "windows" ]; then
      bin_name="dragon.exe"
    fi

    is_musl=false
    if [ "$os" = "linux" ]; then
      if [ -f /etc/alpine-release ]; then
        is_musl=true
      fi

      if command -v ldd >/dev/null 2>&1; then
        if ldd --version 2>&1 | grep -qi musl; then
          is_musl=true
        fi
      fi
    fi

    needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ]; then
        if ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "darwin" ]; then
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        if [ "$avx2" != "1" ]; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "windows" ]; then
        ps="(Add-Type -MemberDefinition \"[DllImport(\"\"kernel32.dll\"\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);\" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)"
        out=""
        if command -v powershell.exe >/dev/null 2>&1; then
          out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        elif command -v pwsh >/dev/null 2>&1; then
          out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        fi
        out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
        if [ "$out" != "true" ] && [ "$out" != "1" ]; then
          needs_baseline=true
        fi
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi
    if [ "$is_musl" = "true" ]; then
      target="$target-musl"
    fi

    filename="$APP-$target$archive_ext"


    if [ "$os" = "linux" ]; then
        if ! command -v tar >/dev/null 2>&1; then
             echo -e "${RED}Error: 'tar' is required but not installed.${NC}"
             exit 1
        fi
    else
        if ! command -v unzip >/dev/null 2>&1; then
            echo -e "${RED}Error: 'unzip' is required but not installed.${NC}"
            exit 1
        fi
    fi

    if [ -z "$requested_version" ]; then
        release_base="https://github.com/VELLORAAI/dragoncode-public-dist/releases/latest/download"
        # `$?` here read the PIPELINE's status (sed's), never curl's, and under
        # `set -euo pipefail` a network failure killed the script on the line
        # above -- so the friendly message below was unreachable on exactly the
        # failure it was written for. Capture the failure explicitly instead.
        latest_json=""
        if ! latest_json=$(curl -fsSL https://api.github.com/repos/VELLORAAI/dragoncode-public-dist/releases/latest 2>/dev/null); then
            echo -e "${RED}Failed to reach GitHub to determine the latest version.${NC}" >&2
            echo -e "${MUTED}Check your connection, or pass --version <x.y.z> to pin one.${NC}" >&2
            exit 1
        fi
        specific_version=$(printf '%s' "$latest_json" | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p')
        if [ -z "$specific_version" ]; then
            # Reached when GitHub answers but the body is not a release (most
            # often an anonymous rate-limit JSON, 60 requests/hour per IP).
            echo -e "${RED}Could not read the latest version from GitHub's response.${NC}" >&2
            echo -e "${MUTED}This is usually API rate limiting; retry shortly, or pass --version <x.y.z>.${NC}" >&2
            exit 1
        fi
    else
        # Strip leading 'v' if present
        requested_version="${requested_version#v}"
        release_base="https://github.com/VELLORAAI/dragoncode-public-dist/releases/download/v${requested_version}"
        specific_version=$requested_version

        # Verify the release exists before downloading
        http_status=$(curl -sIL -o /dev/null -w "%{http_code}" "https://github.com/VELLORAAI/dragoncode-public-dist/releases/tag/v${requested_version}" 2>/dev/null || echo 000)
        case "$http_status" in
            2*)
                ;;
            404)
                echo -e "${RED}Error: Release v${requested_version} not found${NC}" >&2
                echo -e "${MUTED}Available releases: https://github.com/VELLORAAI/dragoncode-public-dist/releases${NC}" >&2
                exit 1
                ;;
            *)
                # Only 404 used to be handled, so a network failure (000) or a
                # 5xx fell through and surfaced later as "no matching release
                # asset" -- a message describing the wrong cause entirely.
                echo -e "${RED}Error: could not confirm release v${requested_version} exists (HTTP ${http_status}).${NC}" >&2
                echo -e "${MUTED}Check your connection and retry.${NC}" >&2
                exit 1
                ;;
        esac
    fi

    # Resolve the actual asset. We may have appended a -baseline (older x86-64,
    # no AVX2) or -musl (Alpine) suffix above, but those variants are not always
    # published. Probe the optimized asset first and fall back to the plain
    # "$os-$arch" build so an older CPU / musl libc gets a clean warning and a
    # working binary instead of a hard 404. Candidates are tried in preference
    # order; the first that exists wins.
    plain_filename="$APP-$os-$arch$archive_ext"
    asset_exists() {
        # A published GitHub release asset resolves (302) to a CDN URL; a missing
        # one returns 404. -L follows the redirect so we observe the final 200.
        local code
        code=$(curl -sIL -o /dev/null -w "%{http_code}" "$1" 2>/dev/null || echo 000)
        [ "$code" = "200" ]
    }
    resolved=""
    for candidate in "$filename" "$plain_filename"; do
        if asset_exists "$release_base/$candidate"; then
            resolved="$candidate"
            break
        fi
    done
    if [ -z "$resolved" ]; then
        echo -e "${RED}Error: no matching release asset for $os-$arch (tried: $filename${NC}$([ "$plain_filename" != "$filename" ] && echo ", $plain_filename")${RED})${NC}"
        echo -e "${MUTED}Available assets: https://github.com/VELLORAAI/dragoncode-public-dist/releases${NC}"
        exit 1
    fi
    if [ "$resolved" != "$filename" ]; then
        echo -e "${ORANGE}Note: an optimized build ($filename) isn't published for your CPU/libc; using the standard build ($resolved). It requires a modern x86-64 CPU (AVX2) and glibc.${NC}" >&2
        filename="$resolved"
    fi
    url="$release_base/$filename"
fi

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${ORANGE}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

# Decide whether there is anything to do, by asking the binary we are about to
# REPLACE — not whatever `dragon` happens to be first on PATH.
#
# This used to run `command -v dragon` / `dragon --version`. When PATH resolved
# a different dragon than $INSTALL_DIR — a shim, a package-manager copy, a stale
# PATH entry, or simply a different $HOME — the installer compared against a
# binary it was never going to touch, printed "already installed", and exited 0
# having installed NOTHING. Reproduced: a 1.5.59 install with a 1.5.60 on PATH
# reported success and stayed on 1.5.59. `dragon_path=$(which dragon)` was
# assigned and never read: the vestige of the $INSTALL_DIR guard this restores.
#
# Returning (rather than exiting) when there is no existing install is the other
# half: absence must mean "go install it", never "nothing to do".
check_version() {
    local target="${INSTALL_DIR}/${bin_name}"

    [ -x "$target" ] || return 0

    # tr -d '\r' because the Windows binary reports with CRLF endings.
    local installed_version
    installed_version=$("$target" --version 2>/dev/null | tr -d '\r' || echo "")

    if [ "$installed_version" != "$specific_version" ]; then
        print_message info "${MUTED}Installed version: ${NC}${installed_version:-unknown}."
        return 0
    fi

    print_message info "${MUTED}Version ${NC}$specific_version${MUTED} already installed"
    # Deliberately NOT `exit 0`: the PATH-configuration block below is how a
    # "dragon: command not found" is repaired, and re-running the installer is
    # the documented remedy. Exiting here meant a same-version reinstall could
    # never fix PATH, and never wrote $GITHUB_PATH in CI.
    skip_download=true
}

unbuffered_sed() {
    if echo | sed -u -e "" >/dev/null 2>&1; then
        sed -nu "$@"
    elif echo | sed -l -e "" >/dev/null 2>&1; then
        sed -nl "$@"
    else
        local pad="$(printf "\n%512s" "")"
        sed -ne "s/$/\\${pad}/" "$@"
    fi
}

print_progress() {
    local bytes="$1"
    local length="$2"
    [ "$length" -gt 0 ] || return 0

    local width=50
    local percent=$(( bytes * 100 / length ))
    [ "$percent" -gt 100 ] && percent=100
    local on=$(( percent * width / 100 ))
    local off=$(( width - on ))

    local filled=$(printf "%*s" "$on" "")
    filled=${filled// /■}
    local empty=$(printf "%*s" "$off" "")
    empty=${empty// /･}

    printf "\r${ORANGE}%s%s %3d%%${NC}" "$filled" "$empty" "$percent" >&4
}

download_with_progress() {
    local url="$1"
    local output="$2"

    if [ -t 2 ]; then
        exec 4>&2
    else
        exec 4>/dev/null
    fi

    # mktemp -d, not a predictable "$$" name: mkfifo into a world-writable
    # directory at a guessable path is a local race.
    local trace_dir
    trace_dir=$(mktemp -d "${TMPDIR:-/tmp}/dragon_trace_XXXXXX")
    local tracefile="${trace_dir}/progress.trace"

    mkfifo "$tracefile"

    # Hide cursor
    printf "\033[?25l" >&4

    trap "trap - RETURN; rm -rf \"$trace_dir\"; printf '\033[?25h' >&4; exec 4>&-" RETURN

    (
        # -f: without it curl writes a 404/5xx error PAGE into $output and
        # exits 0, so the archive is "downloaded" and only fails later as a
        # baffling tar/unzip error.
        curl -f --trace-ascii "$tracefile" -s -L -o "$output" "$url"
    ) &
    local curl_pid=$!

    unbuffered_sed \
        -e 'y/ACDEGHLNORTV/acdeghlnortv/' \
        -e '/^0000: content-length:/p' \
        -e '/^<= recv data/p' \
        "$tracefile" | \
    {
        local length=0
        local bytes=0

        while IFS=" " read -r -a line; do
            [ "${#line[@]}" -lt 2 ] && continue
            local tag="${line[0]} ${line[1]}"

            if [ "$tag" = "0000: content-length:" ]; then
                length="${line[2]}"
                length=$(echo "$length" | tr -d '\r')
                bytes=0
            elif [ "$tag" = "<= recv" ]; then
                local size="${line[3]}"
                bytes=$(( bytes + size ))
                if [ "$length" -gt 0 ]; then
                    print_progress "$bytes" "$length"
                fi
            fi
        done
    }

    wait $curl_pid
    local ret=$?
    echo "" >&4
    return $ret
}

# Called when the archive could not be checked at all. Default is to warn and
# continue, so minimal environments still install; --require-checksum turns the
# same condition into a refusal, for anyone who would rather not install than
# install unverified.
#
# This exists because "skipping verification" was previously a plain info-level
# warning rendered WITHOUT colour, on the two paths most likely to fire in
# practice -- and one of them fires on any rate-limited or NAT'd corporate IP,
# not just on a machine missing tools. Combined with a download that used to
# ignore HTTP errors, that made the integrity gate quietly absent exactly when
# it mattered. It is now visibly a warning, and refusable.
checksum_unverified() {
    local reason="$1"
    if [ "$require_checksum" = true ]; then
        print_message error "Refusing to install ${filename}: ${reason} (--require-checksum)."
        exit 1
    fi
    print_message warning "NOT VERIFIED: ${reason}. Continuing (pass --require-checksum to refuse instead)."
}

# Verify a downloaded archive against the SHA256 digest GitHub publishes for the
# release asset (best-effort supply-chain integrity on top of TLS). A genuine
# mismatch ALWAYS aborts. When the tools to check are absent (no sha256sum/shasum,
# or neither jq nor python3 to read the API, or the API is unreachable) it warns
# and continues rather than breaking installs in minimal environments -- unless
# --require-checksum was passed, which makes that condition fatal.
verify_checksum() {
    local file="$1" fname="$2" version="$3"

    local sha_tool=""
    if command -v sha256sum >/dev/null 2>&1; then
        sha_tool="sha256sum"
    elif command -v shasum >/dev/null 2>&1; then
        sha_tool="shasum -a 256"
    fi
    if [ -z "$sha_tool" ]; then
        checksum_unverified "no sha256 tool (sha256sum/shasum) is available"
        return 0
    fi

    local api="https://api.github.com/repos/VELLORAAI/dragoncode-public-dist/releases/tags/v${version}"
    local json expected=""
    json=$(curl -fsSL "$api" 2>/dev/null) || json=""
    if [ -n "$json" ]; then
        # `|| true` on both: a tool that EXISTS but fails (a shim, a broken
        # install, a wrong-architecture binary) makes the pipeline non-zero, and
        # under `set -euo pipefail` that aborted the installer here — after the
        # download had completed, printing nothing at all. Failing to READ the
        # expected digest is "unverified", which the caller already handles.
        if command -v jq >/dev/null 2>&1; then
            expected=$(printf '%s' "$json" | jq -r --arg n "$fname" '.assets[] | select(.name==$n) | .digest // empty' 2>/dev/null | sed 's/^sha256://' || true)
        elif command -v python3 >/dev/null 2>&1; then
            expected=$(printf '%s' "$json" | python3 -c 'import sys, json
try:
    data = json.load(sys.stdin)
    name = sys.argv[1]
    for a in data.get("assets", []):
        if a.get("name") == name:
            print((a.get("digest") or "").replace("sha256:", ""))
            break
except Exception:
    pass' "$fname" 2>/dev/null || true)
        fi
    fi
    if [ -z "$expected" ]; then
        checksum_unverified "the expected checksum for ${fname} could not be fetched (no jq/python3, or the GitHub API was unreachable or rate-limited)"
        return 0
    fi

    # `|| true` because a sha tool that EXISTS but fails (broken install, wrong
    # architecture, a shim on PATH) makes this pipeline non-zero, and under
    # `set -euo pipefail` that aborted the whole installer right here — after a
    # completed download, with no message whatsoever. Being unable to compute a
    # digest is "unverified", the same as not having a tool; it is not a mismatch
    # and must not masquerade as one.
    local actual=""
    actual=$($sha_tool "$file" 2>/dev/null | awk '{print $1}' || true)
    if [ -z "$actual" ]; then
        checksum_unverified "the sha256 tool (${sha_tool%% *}) could not hash ${fname}"
        return 0
    fi

    if [ "$actual" != "$expected" ]; then
        print_message error "Checksum mismatch for ${fname} - aborting install (possible corrupted or tampered download).\n  expected: sha256:${expected}\n  actual:   sha256:${actual}"
        rm -rf "$(dirname "$file")"
        exit 1
    fi
    print_message info "${MUTED}Verified checksum (sha256).${NC}"
}

download_and_install() {
    print_message info "\n${MUTED}Installing ${NC}DragonCode ${MUTED}version: ${NC}$specific_version"
    # mktemp, not "$$": the old ${TMPDIR:-/tmp}/dragon_install_$$ was predictable,
    # and `mkdir -p` succeeds onto a pre-existing symlink-to-directory, so a local
    # attacker who won the race chose where the archive was extracted.
    local tmp_dir
    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/dragon_install_XXXXXX")

    if [[ "$os" == "windows" ]] || ! [ -t 2 ] || ! download_with_progress "$url" "$tmp_dir/$filename"; then
        # Fallback to standard curl on Windows, non-TTY environments, or if custom progress fails.
        # -f so an HTTP error is an error: without it curl saves the error page as
        # the archive and exits 0, and the install fails later with a tar/unzip
        # message that describes the symptom and not the cause.
        if ! curl -f -# -L -o "$tmp_dir/$filename" "$url"; then
            print_message error "Failed to download ${filename} from ${url}"
            rm -rf "$tmp_dir"
            exit 1
        fi
    fi

    # Integrity gate before we extract and run anything from the archive.
    verify_checksum "$tmp_dir/$filename" "$filename" "$specific_version"

    if [ "$os" = "linux" ]; then
        tar -xzf "$tmp_dir/$filename" -C "$tmp_dir"
    else
        unzip -q "$tmp_dir/$filename" -d "$tmp_dir"
    fi

    place_binary "$tmp_dir/$bin_name"
    rm -rf "$tmp_dir"
}

# Put a freshly-downloaded binary at its final path.
#
# The old code did a bare `mv` (download path) or `cp` (--binary path) straight
# over the destination. Two ways that failed:
#
#  - ETXTBSY. $tmp_dir lives under $TMPDIR and $INSTALL_DIR under $HOME, which
#    on Linux are routinely different filesystems, so `mv` degrades from
#    rename(2) to copy-in-place -- and copying over a RUNNING executable fails
#    with "Text file busy". That is exactly the self-upgrade path: `dragon
#    upgrade` runs this installer while dragon is running. install.ps1 has
#    always handled this (it renames the running image aside first); bash did
#    not.
#  - On macOS, writing over an existing signed binary invalidates the code
#    signature and the process is then killed on launch with no message.
#
# Moving the old file aside first solves both: the destination becomes a fresh
# inode, the running image keeps its own (unlinked) file until it exits, and the
# signature travels with the new file rather than being spliced into the old one.
place_binary() {
    local src="$1"
    local dest="${INSTALL_DIR}/${bin_name}"
    local previous="${dest}.previous"

    if [ -e "$dest" ]; then
        rm -f "$previous" 2>/dev/null || true
        # A rename within one directory is atomic and works even while the old
        # binary is executing.
        if ! mv -f "$dest" "$previous" 2>/dev/null; then
            print_message error "Could not move the existing ${bin_name} aside at ${dest}"
            exit 1
        fi
    fi

    if ! mv -f "$src" "$dest" 2>/dev/null; then
        # Cross-device: fall back to copy + rename into place, never a copy
        # straight over $dest.
        local staged="${dest}.new.$$"
        if ! cp "$src" "$staged" || ! chmod 755 "$staged" || ! mv -f "$staged" "$dest"; then
            rm -f "$staged" 2>/dev/null || true
            # Put the old one back rather than leaving the user with nothing.
            [ -e "$previous" ] && mv -f "$previous" "$dest" 2>/dev/null || true
            print_message error "Failed to install ${bin_name} to ${dest}"
            exit 1
        fi
    fi

    # A failed chmod used to be swallowed with `|| true`, leaving a
    # non-executable binary behind a success message.
    if ! chmod 755 "$dest"; then
        print_message error "Installed ${dest} but could not make it executable"
        exit 1
    fi

    rm -f "$previous" 2>/dev/null || true
}

install_from_binary() {
    print_message info "\n${MUTED}Installing ${NC}DragonCode ${MUTED}from: ${NC}$binary_path"
    local staged
    staged=$(mktemp "${TMPDIR:-/tmp}/dragon_local_XXXXXX")
    if ! cp "$binary_path" "$staged"; then
        rm -f "$staged" 2>/dev/null || true
        print_message error "Could not read ${binary_path}"
        exit 1
    fi
    place_binary "$staged"
}

if [ -n "$binary_path" ]; then
    install_from_binary
else
    check_version
    # check_version sets skip_download when the requested version is already the
    # one sitting in $INSTALL_DIR. Falling through (instead of exiting) means the
    # PATH configuration below still runs, which is the whole point of telling a
    # user to re-run the installer.
    if [ "$skip_download" = false ]; then
        download_and_install
    fi
fi


add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        print_message info "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
        echo -e "\n# dragoncode" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "${MUTED}Successfully added ${NC}DragonCode ${MUTED}to \$PATH in ${NC}$config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

# $SHELL is the LOGIN shell from passwd, not the shell running this script. In
# containers and CI it is frequently /bin/sh while the user's real rc file is
# .bashrc, which sent the PATH line to a file their shell never sources. Prefer
# the parent process's actual shell and fall back to $SHELL.
detect_shell() {
    local parent name
    parent=$(ps -o comm= -p "$PPID" 2>/dev/null | tr -d ' ' || true)
    name=$(basename "${parent#-}" 2>/dev/null || true)
    # Only an INTERACTIVE shell is evidence of what the user actually runs. A
    # parent of sh/dash is almost always a wrapper (`sh -c 'curl … | bash'`, a
    # CI step, the updater) and would send the PATH line to .profile for a
    # zsh user; for those, $SHELL is the better guess.
    case "$name" in
        fish|zsh|bash) echo "$name"; return 0 ;;
    esac
    basename "${SHELL:-sh}"
}

current_shell=$(detect_shell)

# An ARRAY, not a space-separated string. This was previously one string split
# by an unquoted `for file in $config_files`, so any space in $HOME, $ZDOTDIR or
# $XDG_CONFIG_HOME -- "/Users/John Smith" -- shattered it into tokens that match
# no file. The user then silently fell through to "No config file found" and
# their PATH was never written.
case $current_shell in
    fish)
        config_files=("$HOME/.config/fish/config.fish")
    ;;
    zsh)
        config_files=("${ZDOTDIR:-$HOME}/.zshrc" "${ZDOTDIR:-$HOME}/.zshenv" "$XDG_CONFIG_HOME/zsh/.zshrc" "$XDG_CONFIG_HOME/zsh/.zshenv")
    ;;
    bash)
        config_files=("$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile" "$XDG_CONFIG_HOME/bash/.bashrc" "$XDG_CONFIG_HOME/bash/.bash_profile")
    ;;
    ash|dash|sh)
        config_files=("$HOME/.ashrc" "$HOME/.profile" "/etc/profile")
    ;;
    *)
        # Default case if none of the above matches
        config_files=("$HOME/.bashrc" "$HOME/.bash_profile" "$XDG_CONFIG_HOME/bash/.bashrc" "$XDG_CONFIG_HOME/bash/.bash_profile")
    ;;
esac

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in "${config_files[@]}"; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        case $current_shell in
            fish)
                add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
            ;;
            zsh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            bash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            ash|dash|sh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            *)
                export PATH=$INSTALL_DIR:$PATH
                print_message warning "Manually add the directory to $config_file (or similar):"
                print_message info "  export PATH=$INSTALL_DIR:\$PATH"
            ;;
        esac
    fi
fi

# GITHUB_ACTIONS was guarded defensively on the line above, then $GITHUB_PATH
# was dereferenced bare on the next -- an unbound-variable abort under `set -u`
# wherever GITHUB_ACTIONS=true is set without the file (act, some containers).
# Unquoted, too, so a path with a space would have redirected to the wrong file.
if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" = "true" ]; then
    if [ -n "${GITHUB_PATH-}" ]; then
        if echo "$INSTALL_DIR" >> "$GITHUB_PATH"; then
            print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
        else
            print_message warning "Could not append $INSTALL_DIR to \$GITHUB_PATH ($GITHUB_PATH)"
        fi
    else
        print_message warning "GITHUB_ACTIONS is set but \$GITHUB_PATH is not; skipping the PATH export."
    fi
fi

echo -e ""
echo -e "\033[38;5;220m█████   █████    ████    █████   ████   ██  ██\033[0m"
echo -e "\033[38;5;220m██  ██  ██  ██  ██  ██  ██      ██  ██  ███ ██\033[0m"
echo -e "\033[38;5;214m██  ██  █████   ██████  ██ ███  ██  ██  ██████\033[0m"
echo -e "\033[38;5;214m██  ██  ██ ██   ██  ██  ██  ██  ██  ██  ██ ███\033[0m"
echo -e "\033[38;5;208m█████   ██  ██  ██  ██   █████   ████   ██  ██\033[0m"
echo -e "\033[38;5;208m         █████   ████   █████   ██████        \033[0m"
echo -e "\033[38;5;202m        ██      ██  ██  ██  ██  ██            \033[0m"
echo -e "\033[38;5;202m        ██      ██  ██  ██  ██  █████         \033[0m"
echo -e "\033[38;5;166m        ██      ██  ██  ██  ██  ██            \033[0m"
echo -e "\033[38;5;166m         █████   ████   █████   ██████        \033[0m"
echo -e ""
echo -e ""
echo -e "${MUTED}DragonCode is installed. To start:${NC}"
echo -e ""
echo -e "cd <project>  ${MUTED}# Open directory${NC}"
echo -e "dragon        ${MUTED}# Run command${NC}"
echo -e ""

# The PATH export was written to a shell config file, but this installer runs in a
# subshell (curl ... | bash) and cannot update the PATH of the interactive shell that
# launched it. Tell the user how to pick it up now. `command -v dragon` is the signal:
# it fails exactly when a reload is needed, and succeeds on reinstall / already-on-PATH.
if { [ -z "${GITHUB_ACTIONS-}" ] || [ "${GITHUB_ACTIONS}" != "true" ]; } \
   && ! command -v dragon >/dev/null 2>&1; then
    if [ -n "${config_file:-}" ]; then
        echo -e "${ORANGE}dragon isn't on your PATH in this shell yet.${NC} Open a new terminal, or run:"
        echo -e "    source $config_file"
    else
        echo -e "${ORANGE}Add dragon to your PATH:${NC}"
        echo -e "    export PATH=$INSTALL_DIR:\$PATH"
    fi
    echo -e ""
fi

echo -e "${MUTED}For more information visit ${NC}https://github.com/VELLORAAI/dragoncode-public-dist"
echo -e ""
echo -e ""
